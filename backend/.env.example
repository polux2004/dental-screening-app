# Copiar a .env y ajustar valores locales
APP_NAME="Dental Screening API"
DEBUG=false

DATABASE_URL=sqlite:///./dental_screening.db

MODEL_PATH=app/ml/weights/best.pt
GINGIVITIS_MODEL_PATH=app/ml/weights/best_gingivitis.pt
CONF_THRESHOLD=0.5
MAX_UPLOAD_BYTES=10485760

MIN_BRIGHTNESS=85.0
MAX_BRIGHTNESS=245.0
BLUR_THRESHOLD=30.0

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
