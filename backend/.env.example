# Copiar a .env y ajustar valores locales
APP_NAME="Dental Screening API"
DEBUG=false

DATABASE_URL=sqlite:///./dental_screening.db

MODEL_PATH=app/ml/weights/best.pt
CONF_THRESHOLD=0.5
IOU_THRESHOLD=0.45

MIN_BRIGHTNESS=50.0
MAX_BRIGHTNESS=220.0
BLUR_THRESHOLD=30.0

CORS_ORIGINS=["http://localhost:5173"]
